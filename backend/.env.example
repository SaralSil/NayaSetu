# Django Settings
SECRET_KEY=change-this-in-production-django-secret-key-nyayasetu
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL Database URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Supabase Auth Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# Google Gemini API Key (For Notice Decryption & Multilingual Explanations)
GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]

# CORS Settings (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
