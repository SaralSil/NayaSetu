              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant_name\": \"Subhash Chandra Mondal\",\n  \"contact_phone\": \"9830012345\",\n  \"residence_address\": \"Vill: Joynagar, Block: Joynagar-II, South 24 Parganas\",\n  \"scheme_name\": \"Krishak Bandhu (Natun)\",\n  \"application_ref_no\": \"KB/2025/110482\",\n  \"original_application_date\": \"10/11/2025\",\n  \"grievance_type\": \"dbt_failure\",\n  \"addressed_to\": \"The Assistant Director of Agriculture (ADA),\",\n  \"facts_statement\": \"Kharif season installment was received, but Rabi season installment has not been credited due to IFSC change following bank merger.\",\n  \"language\": \"en\"\n}"
