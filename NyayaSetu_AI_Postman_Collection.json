    {
      "name": "04. Notice & Rejection Decrypter (Gemini AI)",
      "item": [
        {
          "name": "Explain Notice (Bank NPCI Error Text)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Your Lakshmir Bhandar application status is Incomplete. Reason: NPCI mapping inactive / Bank Account Validation Failed. Please contact BDO.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analyzer/explain/",
              "host": ["{{base_url}}"],
              "path": ["api", "analyzer", "explain", ""]
            },
            "description": "Parses SMS or notice text, detects the scheme, translates into plain Bengali, English & Hindi, and provides step-by-step physical remedy instructions."
          }
        },
        {
          "name": "Explain Notice (Krishak Bandhu Land Mismatch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Krishak Bandhu application on hold. Reason: RoR Khatian record not mutated in applicant name in Banglarbhumi.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analyzer/explain/",
              "host": ["{{base_url}}"],
              "path": ["api", "analyzer", "explain", ""]
            }
          }
        },
        {
          "name": "Explain Notice (Upload Receipt Image)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Upload photo/screenshot of receipt slip or rejection letter"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/analyzer/explain/",
              "host": ["{{base_url}}"],
              "path": ["api", "analyzer", "explain", ""]
            },
            "description": "Upload an image of an application receipt slip or status letter for multimodal vision analysis."
          }
        }
      ]
    },
    {
      "name": "05. Grievance & Representation Drafter",
      "item": [
        {
          "name": "Generate Grievance Draft - Bengali (বাংলা)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant_name\": \"Mita Roy\",\n  \"contact_phone\": \"9876543210\",\n  \"residence_address\": \"গ্রাম: গোপালনগর, জিপি: হরিদাসপুর, ব্লক: ক্যানিং-১, দক্ষিণ ২৪ পরগণা\",\n  \"scheme_name\": \"লক্ষ্মীর ভাণ্ডার\",\n  \"application_ref_no\": \"LB/2026/089211\",\n  \"original_application_date\": \"১৫/০১/২০২৬\",\n  \"grievance_type\": \"delay\",\n  \"addressed_to\": \"মাননীয় সমষ্টি উন্নয়ন আধিকারিক (BDO) মহাশয়,\",\n  \"facts_statement\": \"আবেদন করার পর ৫ মাস অতিবাহিত হলেও কোনো এসএমএস বা ভাতা পাইনি। ব্যাংক অ্যাকাউন্ট যাচাইকরণে সমস্যা দেখাচ্ছে কিন্তু ব্যাংকে আধার লিঙ্ক সক্রিয় করা হয়েছে।\",\n  \"language\": \"bn\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/grievances/generate/",
              "host": ["{{base_url}}"],
              "path": ["api", "grievances", "generate", ""]
            },
            "description": "Generates a formal, respectful administrative representation in Bengali addressed to BDO or Duare Sarkar counters."
          }
        },
        {
          "name": "Generate Grievance Draft - English",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
