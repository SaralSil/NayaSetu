{
  "info": {
    "_postman_id": "b3f07a12-8e11-4a25-9c88-nyayasetu001",
    "name": "NyayaSetu AI - West Bengal Gov Schemes API",
    "description": "API collection for NyayaSetu AI: West Bengal Government Scheme & Citizen Rights Assistant.\nIncludes Scheme Discovery, Eligibility Wizard, Notice/SMS Decrypter, and Grievance Drafter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": ["{{base_url}}"],
          "path": ["api", "health", ""]
        },
        "description": "Checks if the NyayaSetu AI Django API backend is running and healthy."
      }
    },
    {
      "name": "02. Schemes Engine",
      "item": [
        {
          "name": "Get All Schemes (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schemes/",
              "host": ["{{base_url}}"],
              "path": ["api", "schemes", ""]
            },
            "description": "Returns list of active West Bengal schemes (Lakshmir Bhandar, Krishak Bandhu, Kanyashree, Aikyashree, etc.)."
          }
        },
        {
          "name": "Search Schemes (by Keyword)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schemes/?search=farmer",
              "host": ["{{base_url}}"],
              "path": ["api", "schemes", ""],
              "query": [
                {
                  "key": "search",
                  "value": "farmer",
                  "description": "Search keyword in English or Bengali"
                }
              ]
            },
            "description": "Search schemes by title, Bengali name, or description."
          }
        },
        {
          "name": "Filter Schemes by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schemes/?category=women",
              "host": ["{{base_url}}"],
              "path": ["api", "schemes", ""],
              "query": [
                {
                  "key": "category",
                  "value": "women",
                  "description": "Categories: women, agriculture, education, tribal_caste, health"
                }
              ]
            },
            "description": "Filter schemes by target beneficiary category."
          }
        },
        {
          "name": "Get Scheme Detail (Lakshmir Bhandar)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schemes/lakshmir-bhandar/",
              "host": ["{{base_url}}"],
              "path": ["api", "schemes", "lakshmir-bhandar", ""]
            },
            "description": "Returns comprehensive details, required document checklist with notes (e.g. single bank a/c mandatory), and common rejection remedies."
